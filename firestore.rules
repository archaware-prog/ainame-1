rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'krushnachaware84@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isNotBanned() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'banned'
      );
    }

    // --- Entity Validators ---
    function isValidUserDoc(data) {
      return data.keys().hasAll(['displayName', 'email', 'role', 'status', 'plan']) &&
        data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'role', 'status', 'plan',
          'subscriptionPlanId', 'subscriptionPlanName', 'planExpiresAt',
          'createdAt', 'lastLoginAt'
        ]) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.role in ['user', 'admin'] &&
        data.status in ['active', 'banned'] &&
        data.plan in ['free', 'premium'] &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('subscriptionPlanId' in data) || data.subscriptionPlanId == null || (data.subscriptionPlanId is string && data.subscriptionPlanId.size() <= 128)) &&
        (!('subscriptionPlanName' in data) || data.subscriptionPlanName == null || (data.subscriptionPlanName is string && data.subscriptionPlanName.size() <= 100)) &&
        (!('planExpiresAt' in data) || data.planExpiresAt == null || (data.planExpiresAt is string && data.planExpiresAt.size() <= 64));
    }

    function isValidMovieDoc(data) {
      return data.keys().hasAll(['title', 'slug', 'type', 'status', 'views', 'likesCount']) &&
        data.keys().hasOnly([
          'title', 'slug', 'type', 'description', 'releaseYear', 'duration', 'rating',
          'ageRating', 'language', 'country', 'genres', 'cast', 'director', 'tags',
          'posterUrl', 'bannerUrl', 'trailerUrl', 'videoSources', 'subtitles',
          'isFeatured', 'isTrending', 'isPremium', 'requiresSignIn', 'requiredPlanId', 'requiredPlanName',
          'access', 'seasonAccess', 'defaultAdFormat',
          'status', 'views', 'likesCount', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 180 &&
        data.type in ['movie', 'series'] &&
        data.status in ['published', 'draft'] &&
        data.views is number && data.views >= 0 &&
        data.likesCount is number && data.likesCount >= 0 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
        (!('releaseYear' in data) || (data.releaseYear is number && data.releaseYear >= 1880 && data.releaseYear <= 2100)) &&
        (!('duration' in data) || (data.duration is number && data.duration >= 0 && data.duration <= 2000)) &&
        (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 10)) &&
        (!('requiresSignIn' in data) || data.requiresSignIn is bool) &&
        (!('requiredPlanId' in data) || data.requiredPlanId == null || (data.requiredPlanId is string && data.requiredPlanId.size() <= 128)) &&
        (!('requiredPlanName' in data) || data.requiredPlanName == null || (data.requiredPlanName is string && data.requiredPlanName.size() <= 100)) &&
        (!('access' in data) || data.access is map) &&
        (!('seasonAccess' in data) || data.seasonAccess is map) &&
        (!('defaultAdFormat' in data) || data.defaultAdFormat in ['inherit', 'video', 'banner', 'auto']) &&
        (!('genres' in data) || (data.genres is list && data.genres.size() <= 20)) &&
        (!('cast' in data) || (data.cast is list && data.cast.size() <= 40)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 30)) &&
        (!('videoSources' in data) || (data.videoSources is list && data.videoSources.size() <= 12)) &&
        (!('subtitles' in data) || (data.subtitles is list && data.subtitles.size() <= 20));
    }

    function isValidPlanDoc(data) {
      return data.keys().hasAll(['name', 'slug', 'pricePerMonth', 'currency', 'billingInterval', 'isActive', 'order']) &&
        data.keys().hasOnly([
          'name', 'slug', 'pricePerMonth', 'currency', 'billingInterval',
          'description', 'features', 'badgeColor', 'isActive', 'order',
          'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 &&
        data.pricePerMonth is number && data.pricePerMonth >= 0 && data.pricePerMonth <= 10000 &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10 &&
        data.billingInterval == 'monthly' &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('features' in data) || (data.features is list && data.features.size() <= 12 && (data.features.size() == 0 || data.features[0] is string))) &&
        (!('badgeColor' in data) || (data.badgeColor is string && data.badgeColor.size() <= 32)) &&
        data.isActive is bool &&
        data.order is number && data.order >= 0;
    }

    function isValidEpisodeDoc(data) {
      return data.keys().hasAll(['number', 'title', 'duration']) &&
        data.keys().hasOnly(['number', 'title', 'description', 'duration', 'thumbnailUrl', 'videoSources', 'subtitles', 'access', 'createdAt', 'seasonNumber']) &&
        data.number is number && data.number >= 1 && data.number <= 1000 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        data.duration is number && data.duration >= 0 && data.duration <= 1000 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1500)) &&
        (!('access' in data) || data.access is map) &&
        (!('videoSources' in data) || (data.videoSources is list && data.videoSources.size() <= 12)) &&
        (!('subtitles' in data) || (data.subtitles is list && data.subtitles.size() <= 20));
    }

    function isValidGenreDoc(data) {
      return data.keys().hasAll(['name', 'slug', 'order']) &&
        data.keys().hasOnly(['name', 'slug', 'order']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 60 &&
        data.order is number && data.order >= 0;
    }

    function isValidBannerDoc(data) {
      return data.keys().hasAll(['movieId', 'imageUrl', 'order', 'isActive']) &&
        data.keys().hasOnly(['movieId', 'imageUrl', 'order', 'isActive']) &&
        data.movieId is string && data.movieId.size() >= 1 && data.movieId.size() <= 128 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 1500 &&
        data.order is number && data.order >= 0 &&
        data.isActive is bool;
    }

    function isValidCommentDoc(data) {
      return data.keys().hasAll(['movieId', 'uid', 'userName', 'text', 'createdAt', 'isHidden']) &&
        data.keys().hasOnly(['movieId', 'uid', 'userName', 'userPhoto', 'text', 'createdAt', 'isHidden']) &&
        data.movieId is string && data.movieId.size() >= 1 && data.movieId.size() <= 128 &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
        (!('userPhoto' in data) || (data.userPhoto is string && data.userPhoto.size() <= 1000)) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        data.isHidden is bool;
    }

    function isValidReportDoc(data) {
      return data.keys().hasAll(['movieId', 'uid', 'type', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly(['movieId', 'uid', 'type', 'message', 'status', 'createdAt']) &&
        data.movieId is string && data.movieId.size() >= 1 && data.movieId.size() <= 128 &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.type in ['broken link', 'wrong info', 'other'] &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.status in ['open', 'resolved'];
    }

    function isValidSiteSettingsDoc(data) {
      return data.keys().hasAll(['siteName', 'primaryColor', 'maintenanceMode', 'allowRegistration']) &&
        data.keys().hasOnly([
          'siteName', 'logoUrl', 'primaryColor', 'announcement', 'maintenanceMode',
          'allowRegistration', 'footerLinks', 'tmdbApiKey',
          'branding', 'theme', 'typography', 'shape', 'homeLayout',
          'navigation', 'footer', 'popup', 'maintenance', 'cookieConsent',
          'player', 'seo', 'customCode', 'ads', 'i18n', 'featureFlags'
        ]) &&
        data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 80 &&
        data.primaryColor is string && data.primaryColor.size() >= 4 && data.primaryColor.size() <= 20 &&
        data.maintenanceMode is bool &&
        data.allowRegistration is bool &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 1500)) &&
        (!('tmdbApiKey' in data) || (data.tmdbApiKey is string && data.tmdbApiKey.size() <= 200)) &&
        (!('branding' in data) || data.branding is map) &&
        (!('theme' in data) || data.theme is map) &&
        (!('typography' in data) || data.typography is map) &&
        (!('shape' in data) || data.shape is map) &&
        (!('homeLayout' in data) || data.homeLayout is map) &&
        (!('navigation' in data) || data.navigation is map) &&
        (!('footer' in data) || data.footer is map) &&
        (!('popup' in data) || data.popup is map) &&
        (!('maintenance' in data) || data.maintenance is map) &&
        (!('cookieConsent' in data) || data.cookieConsent is map) &&
        (!('player' in data) || data.player is map) &&
        (!('seo' in data) || data.seo is map) &&
        (!('customCode' in data) || data.customCode is map) &&
        (!('ads' in data) || data.ads is map) &&
        (!('i18n' in data) || data.i18n is map) &&
        (!('featureFlags' in data) || data.featureFlags is map);
    }

    function isValidCustomPageDoc(data) {
      return data.keys().hasAll(['title', 'slug', 'contentHtml', 'showContactForm', 'status', 'showInFooter', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'slug', 'contentHtml', 'showContactForm', 'status', 'showInFooter', 'updatedAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 &&
        data.contentHtml is string && data.contentHtml.size() <= 50000 &&
        data.showContactForm is bool &&
        data.status in ['published', 'draft'] &&
        data.showInFooter is bool &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidContactMessageDoc(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'pageSlug', 'status', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'subject', 'message', 'pageSlug', 'status', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 160 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 3000 &&
        data.pageSlug is string && data.pageSlug.size() >= 1 && data.pageSlug.size() <= 80 &&
        data.status in ['unread', 'read', 'archived'] &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidActivityLogDoc(data) {
      return data.keys().hasAll(['adminUid', 'action', 'targetId', 'createdAt']) &&
        data.keys().hasOnly(['adminUid', 'action', 'targetId', 'createdAt']) &&
        data.adminUid is string && data.adminUid.size() >= 1 && data.adminUid.size() <= 128 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 200 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128;
    }

    function isValidCustomAdDoc(data) {
      return data.keys().hasAll([
          'name', 'type', 'placement', 'imageUrl', 'redirectUrl',
          'startDate', 'endDate', 'status', 'priority', 'impressions', 'clicks'
        ]) &&
        data.keys().hasOnly([
          'name', 'type', 'placement', 'imageUrl', 'mobileImageUrl', 'altText',
          'redirectUrl', 'openInNewTab', 'targetContentType', 'targetIds',
          'startDate', 'endDate', 'status', 'priority', 'weight', 'dailyImpressionCap',
          'devices', 'audience', 'advertiserName', 'isMandatoryClickBanner',
          'requiredViewSeconds', 'autoUnlockAfterCountdown', 'impressions', 'clicks',
          'completions', 'createdAt', 'updatedAt', 'createdBy'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
        data.type == 'image' &&
        data.placement in ['player', 'home', 'banner'] &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 1500 &&
        (!('mobileImageUrl' in data) || (data.mobileImageUrl is string && data.mobileImageUrl.size() <= 1500)) &&
        (!('altText' in data) || (data.altText is string && data.altText.size() <= 200)) &&
        (!('advertiserName' in data) || (data.advertiserName is string && data.advertiserName.size() <= 120)) &&
        (!('isMandatoryClickBanner' in data) || data.isMandatoryClickBanner is bool) &&
        (!('requiredViewSeconds' in data) || (data.requiredViewSeconds is number && data.requiredViewSeconds >= 3 && data.requiredViewSeconds <= 180)) &&
        (!('autoUnlockAfterCountdown' in data) || data.autoUnlockAfterCountdown is bool) &&
        data.redirectUrl is string && data.redirectUrl.size() >= 1 && data.redirectUrl.size() <= 1500 &&
        (!('openInNewTab' in data) || data.openInNewTab is bool) &&
        (!('targetContentType' in data) || data.targetContentType in ['all', 'movie', 'video', 'tvshow']) &&
        (!('targetIds' in data) || (data.targetIds is list && data.targetIds.size() <= 100)) &&
        data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 32 &&
        data.endDate is string && data.endDate.size() >= 8 && data.endDate.size() <= 32 &&
        data.status in ['active', 'inactive'] &&
        data.priority is number && data.priority >= 1 && data.priority <= 10 &&
        (!('weight' in data) || (data.weight is number && data.weight >= 1 && data.weight <= 100)) &&
        (!('dailyImpressionCap' in data) || (data.dailyImpressionCap is number && data.dailyImpressionCap >= 0)) &&
        (!('devices' in data) || (data.devices is list && data.devices.size() <= 5)) &&
        (!('audience' in data) || data.audience in ['all', 'free', 'premium', 'guest']) &&
        data.impressions is number && data.impressions >= 0 &&
        data.clicks is number && data.clicks >= 0 &&
        (!('completions' in data) || (data.completions is number && data.completions >= 0));
    }

    function isValidVastAdDoc(data) {
      return data.keys().hasAll([
          'name', 'type', 'vastTagUrl', 'targetType', 'startDate', 'endDate',
          'status', 'priority', 'impressions', 'completions', 'skips', 'clicks', 'errors'
        ]) &&
        data.keys().hasOnly([
          'name', 'type', 'vastTagUrl', 'targetType', 'targetIds',
          'midRollAtSeconds', 'overlayStartSeconds', 'overlayDurationSeconds',
          'skipAfterSeconds', 'unlockDurationSeconds', 'isUnlockEligible',
          'startDate', 'endDate', 'status', 'priority',
          'audience', 'devices', 'impressions', 'completions', 'skips', 'clicks', 'errors',
          'createdAt', 'updatedAt', 'createdBy'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
        data.type in ['pre-roll', 'mid-roll', 'post-roll', 'overlay'] &&
        data.vastTagUrl is string && data.vastTagUrl.size() >= 1 && data.vastTagUrl.size() <= 2000 &&
        data.targetType in ['movie', 'video', 'tvshow'] &&
        (!('targetIds' in data) || (data.targetIds is list && data.targetIds.size() <= 100)) &&
        (!('midRollAtSeconds' in data) || (data.midRollAtSeconds is list && data.midRollAtSeconds.size() <= 20)) &&
        (!('overlayStartSeconds' in data) || (data.overlayStartSeconds is number && data.overlayStartSeconds >= 0)) &&
        (!('overlayDurationSeconds' in data) || (data.overlayDurationSeconds is number && data.overlayDurationSeconds >= 1 && data.overlayDurationSeconds <= 120)) &&
        (!('skipAfterSeconds' in data) || (data.skipAfterSeconds is number && data.skipAfterSeconds >= 0 && data.skipAfterSeconds <= 60)) &&
        (!('unlockDurationSeconds' in data) || (data.unlockDurationSeconds is number && data.unlockDurationSeconds >= 3 && data.unlockDurationSeconds <= 180)) &&
        (!('isUnlockEligible' in data) || data.isUnlockEligible is bool) &&
        data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 32 &&
        data.endDate is string && data.endDate.size() >= 8 && data.endDate.size() <= 32 &&
        data.status in ['active', 'inactive'] &&
        data.priority is number && data.priority >= 1 && data.priority <= 10 &&
        (!('audience' in data) || data.audience in ['all', 'free', 'premium', 'guest']) &&
        (!('devices' in data) || (data.devices is list && data.devices.size() <= 5)) &&
        data.impressions is number && data.impressions >= 0 &&
        data.completions is number && data.completions >= 0 &&
        data.skips is number && data.skips >= 0 &&
        data.clicks is number && data.clicks >= 0 &&
        data.errors is number && data.errors >= 0;
    }

    function isValidAdEventDoc(data) {
      return data.keys().hasAll(['adId', 'adKind', 'event', 'placement', 'device', 'createdAt']) &&
        data.keys().hasOnly([
          'adId', 'adKind', 'event', 'contentId', 'episodeId', 'contentType',
          'placement', 'format', 'uid', 'device', 'createdAt'
        ]) &&
        data.adId is string && data.adId.size() >= 1 && data.adId.size() <= 128 &&
        data.adKind in ['custom', 'vast', 'gate', 'unlock'] &&
        data.event in [
          'impression', 'click', 'complete', 'skip', 'error',
          'banner_complete', 'gate_view', 'video_start', 'ad_unlock_granted',
          'subscribe_click', 'subscribe_convert', 'drop_off'
        ] &&
        (!('contentId' in data) || (data.contentId is string && data.contentId.size() <= 128)) &&
        (!('episodeId' in data) || (data.episodeId is string && data.episodeId.size() <= 128)) &&
        (!('contentType' in data) || (data.contentType is string && data.contentType.size() <= 32)) &&
        (!('format' in data) || data.format in ['video', 'banner']) &&
        data.placement is string && data.placement.size() >= 1 && data.placement.size() <= 40 &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
        data.device in ['desktop', 'mobile', 'tablet'] &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidAdSettingsDoc(data) {
      return data.keys().hasAll([
          'adsEnabled', 'hideAdsForPremium', 'maxAdsPerSession', 'minSecondsBetweenVideoAds',
          'adLabelText', 'showAdLabel', 'testMode', 'defaultDailyCap'
        ]) &&
        data.keys().hasOnly([
          'adsEnabled', 'hideAdsForPremium', 'maxAdsPerSession', 'minSecondsBetweenVideoAds',
          'adLabelText', 'showAdLabel', 'testMode', 'defaultDailyCap',
          'adUnlockEnabled', 'guestAdUnlock', 'maxUnlocksPerHour', 'defaultUnlockValidityHours',
          'failureFallback', 'unlockSkipAllowed', 'defaultUnlockAdFormat',
          'bannerCountdownSeconds', 'bannerAutoUnlockAfterCountdown',
          'gateTitle', 'gateDescription', 'watchAdButtonText', 'watchAdSubtext',
          'subscribeButtonText', 'subscribeSubtext', 'bannerPromptText', 'badgeSettings'
        ]) &&
        data.adsEnabled is bool &&
        data.hideAdsForPremium is bool &&
        data.maxAdsPerSession is number && data.maxAdsPerSession >= 0 && data.maxAdsPerSession <= 100 &&
        data.minSecondsBetweenVideoAds is number && data.minSecondsBetweenVideoAds >= 0 && data.minSecondsBetweenVideoAds <= 7200 &&
        data.adLabelText is string && data.adLabelText.size() >= 1 && data.adLabelText.size() <= 24 &&
        data.showAdLabel is bool &&
        data.testMode is bool &&
        data.defaultDailyCap is number && data.defaultDailyCap >= 0 &&
        (!('adUnlockEnabled' in data) || data.adUnlockEnabled is bool) &&
        (!('guestAdUnlock' in data) || data.guestAdUnlock is bool) &&
        (!('maxUnlocksPerHour' in data) || (data.maxUnlocksPerHour is number && data.maxUnlocksPerHour >= 0 && data.maxUnlocksPerHour <= 500)) &&
        (!('defaultUnlockValidityHours' in data) || (data.defaultUnlockValidityHours is number && data.defaultUnlockValidityHours >= 0 && data.defaultUnlockValidityHours <= 720)) &&
        (!('failureFallback' in data) || data.failureFallback in ['keep_locked', 'free_once']) &&
        (!('unlockSkipAllowed' in data) || data.unlockSkipAllowed is bool) &&
        (!('defaultUnlockAdFormat' in data) || data.defaultUnlockAdFormat in ['video', 'banner', 'auto']) &&
        (!('bannerCountdownSeconds' in data) || (data.bannerCountdownSeconds is number && data.bannerCountdownSeconds >= 3 && data.bannerCountdownSeconds <= 180)) &&
        (!('bannerAutoUnlockAfterCountdown' in data) || data.bannerAutoUnlockAfterCountdown is bool) &&
        (!('gateTitle' in data) || (data.gateTitle is string && data.gateTitle.size() <= 160)) &&
        (!('gateDescription' in data) || (data.gateDescription is string && data.gateDescription.size() <= 500)) &&
        (!('watchAdButtonText' in data) || (data.watchAdButtonText is string && data.watchAdButtonText.size() <= 80)) &&
        (!('watchAdSubtext' in data) || (data.watchAdSubtext is string && data.watchAdSubtext.size() <= 120)) &&
        (!('subscribeButtonText' in data) || (data.subscribeButtonText is string && data.subscribeButtonText.size() <= 80)) &&
        (!('subscribeSubtext' in data) || (data.subscribeSubtext is string && data.subscribeSubtext.size() <= 120)) &&
        (!('bannerPromptText' in data) || (data.bannerPromptText is string && data.bannerPromptText.size() <= 160)) &&
        (!('badgeSettings' in data) || data.badgeSettings is map);
    }

    function isValidAdUnlockDoc(data, uid, contentId) {
      return data.keys().hasAll(['contentId', 'contentType', 'uid', 'unlockedAt', 'adId', 'adKind', 'format', 'method']) &&
        data.keys().hasOnly([
          'contentId', 'seriesId', 'contentType', 'uid', 'unlockedAt', 'expiresAt',
          'sessionOnly', 'adId', 'adKind', 'format', 'method'
        ]) &&
        data.contentId == contentId &&
        data.uid == uid &&
        data.contentType in ['movie', 'episode'] &&
        data.unlockedAt is string && data.unlockedAt.size() <= 64 &&
        (!('expiresAt' in data) || data.expiresAt == null || (data.expiresAt is string && data.expiresAt.size() <= 64)) &&
        (!('sessionOnly' in data) || data.sessionOnly is bool) &&
        (!('seriesId' in data) || (data.seriesId is string && data.seriesId.size() <= 128)) &&
        data.adId is string && data.adId.size() >= 1 && data.adId.size() <= 128 &&
        data.adKind in ['custom', 'vast', 'fallback'] &&
        data.format in ['video', 'banner', 'fallback'] &&
        data.method in ['rewarded_ad', 'fallback_once'];
    }

    function isValidLibraryDoc(data, titleId) {
      return data.keys().hasAll(['titleId', 'titleName', 'titleType', 'addedAt', 'status']) &&
        data.keys().hasOnly(['titleId', 'titleName', 'titleType', 'posterUrl', 'addedAt', 'status']) &&
        data.titleId == titleId &&
        data.titleName is string && data.titleName.size() >= 1 && data.titleName.size() <= 180 &&
        data.titleType in ['movie', 'series'] &&
        (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 1500)) &&
        data.addedAt is string && data.addedAt.size() >= 8 && data.addedAt.size() <= 64 &&
        data.status in ['watching', 'completed', 'paused'];
    }

    function isValidProgressDoc(data, titleId) {
      return data.keys().hasAll([
          'titleId', 'totalUnits', 'completedUnits', 'completedEpisodeIds', 'progressPercent', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'titleId', 'totalUnits', 'completedUnits', 'completedEpisodeIds',
          'progressPercent', 'lastSeasonId', 'lastEpisodeId', 'updatedAt'
        ]) &&
        data.titleId == titleId &&
        data.totalUnits is number && data.totalUnits >= 1 && data.totalUnits <= 500 &&
        data.completedUnits is number && data.completedUnits >= 0 && data.completedUnits <= data.totalUnits &&
        data.completedEpisodeIds is list && data.completedEpisodeIds.size() <= 500 &&
        data.completedEpisodeIds.size() == data.completedUnits &&
        data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100 &&
        (!('lastSeasonId' in data) || data.lastSeasonId == null || (data.lastSeasonId is string && data.lastSeasonId.size() <= 128)) &&
        (!('lastEpisodeId' in data) || data.lastEpisodeId == null || (data.lastEpisodeId is string && data.lastEpisodeId.size() <= 128)) &&
        data.updatedAt is string && data.updatedAt.size() >= 8 && data.updatedAt.size() <= 64;
    }

    function isValidActivityDoc(data) {
      return data.keys().hasAll(['type', 'titleId', 'titleName', 'createdAt']) &&
        data.keys().hasOnly([
          'type', 'titleId', 'titleName', 'episodeId', 'durationSeconds', 'rating', 'createdAt'
        ]) &&
        data.type in ['watch', 'completed', 'rating', 'library'] &&
        data.titleId is string && isValidId(data.titleId) &&
        data.titleName is string && data.titleName.size() >= 1 && data.titleName.size() <= 180 &&
        (!('episodeId' in data) || data.episodeId == null || (data.episodeId is string && data.episodeId.size() <= 128)) &&
        (!('durationSeconds' in data) || (data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400)) &&
        (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5)) &&
        data.createdAt is string && data.createdAt.size() >= 8 && data.createdAt.size() <= 64;
    }

    function isValidAchievementDoc(data, achievementId) {
      return data.keys().hasAll(['kind', 'titleId', 'titleName', 'issuedAt']) &&
        data.keys().hasOnly(['kind', 'titleId', 'titleName', 'issuedAt', 'imageUrl']) &&
        data.kind in ['title_completed'] &&
        data.titleId is string && isValidId(data.titleId) &&
        achievementId == (data.kind + '_' + data.titleId) &&
        data.titleName is string && data.titleName.size() >= 1 && data.titleName.size() <= 180 &&
        data.issuedAt is string && data.issuedAt.size() >= 8 && data.issuedAt.size() <= 64 &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1500));
    }

    function isValidOrderDoc(data) {
      return data.keys().hasAll([
          'userId', 'userEmail', 'userName', 'planId', 'planName',
          'amount', 'currency', 'paymentStatus', 'paymentMethod', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'userEmail', 'userName', 'planId', 'planName',
          'amount', 'currency', 'paymentStatus', 'paymentMethod', 'reference',
          'createdAt', 'paidAt', 'updatedAt'
        ]) &&
        data.userId is string && isValidId(data.userId) &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 200 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
        data.planId is string && isValidId(data.planId) &&
        data.planName is string && data.planName.size() >= 1 && data.planName.size() <= 80 &&
        data.amount is number && data.amount >= 0 && data.amount <= 10000 &&
        math.abs(data.amount * 100 - math.round(data.amount * 100)) < 0.0001 &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10 &&
        data.paymentStatus in ['pending', 'paid', 'failed', 'refunded'] &&
        data.paymentMethod in ['manual', 'upi', 'card', 'other'] &&
        (!('reference' in data) || data.reference == null || (data.reference is string && data.reference.size() <= 100)) &&
        data.createdAt is string && data.createdAt.size() >= 8 && data.createdAt.size() <= 64 &&
        (!('paidAt' in data) || data.paidAt == null || (data.paidAt is string && data.paidAt.size() >= 8 && data.paidAt.size() <= 64)) &&
        data.updatedAt is string && data.updatedAt.size() >= 8 && data.updatedAt.size() <= 64;
    }

    function isValidPostDoc(data) {
      return data.keys().hasAll([
          'title', 'slug', 'excerpt', 'contentHtml', 'status', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'slug', 'excerpt', 'contentHtml', 'coverUrl', 'status',
          'authorUid', 'createdAt', 'updatedAt', 'publishedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9-]+$') &&
        data.excerpt is string && data.excerpt.size() >= 1 && data.excerpt.size() <= 500 &&
        data.contentHtml is string && data.contentHtml.size() >= 1 && data.contentHtml.size() <= 50000 &&
        (!('coverUrl' in data) || data.coverUrl == null || (data.coverUrl is string && data.coverUrl.size() <= 1500)) &&
        data.status in ['draft', 'published'] &&
        data.authorUid is string && isValidId(data.authorUid) &&
        data.createdAt is string && data.createdAt.size() >= 8 && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() >= 8 && data.updatedAt.size() <= 64 &&
        (!('publishedAt' in data) || data.publishedAt == null || (data.publishedAt is string && data.publishedAt.size() >= 8 && data.publishedAt.size() <= 64));
    }

    // --- Collection Rules ---

    // Users collection (PII isolated to owner or admin)
    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(uid) && isSignedIn() && isValidUserDoc(incoming()) && (
        isAdmin() || (
          isOwner(uid) &&
          incoming().role == 'user' &&
          incoming().status == 'active' &&
          incoming().plan == 'free'
        )
      );
      allow update: if isValidId(uid) && isSignedIn() && isValidUserDoc(incoming()) && (
        (
          isAdmin() &&
          !(isOwner(uid) && incoming().role != existing().role)
        ) || (
          isOwner(uid) &&
          isNotBanned() &&
          incoming().role == existing().role &&
          incoming().status == existing().status && (
            // Action: Update profile details
            (
              incoming().plan == existing().plan &&
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt'])
            ) ||
            // Action: Cancel active subscription back to free
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['plan', 'subscriptionPlanId', 'subscriptionPlanName', 'planExpiresAt', 'lastLoginAt']) &&
              incoming().plan == 'free' &&
              incoming().subscriptionPlanId == null &&
              incoming().subscriptionPlanName == null &&
              incoming().planExpiresAt == null
            )
          )
        )
      );
      allow delete: if isValidId(uid) && (
        (isOwner(uid) && !isAdmin()) ||
        (isAdmin() && request.auth.uid != uid)
      );

      match /watchlist/{movieId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isValidId(movieId) && isOwner(uid) && isNotBanned() &&
          incoming().keys().hasAll(['movieId', 'addedAt']) &&
          incoming().keys().hasOnly(['movieId', 'addedAt']) &&
          incoming().movieId == movieId;
        allow delete: if isValidId(movieId) && (isOwner(uid) || isAdmin());
      }

      match /history/{movieId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isValidId(movieId) && isOwner(uid) && isNotBanned() &&
          incoming().keys().hasAll(['movieId', 'progressSeconds', 'durationSeconds', 'updatedAt']) &&
          incoming().keys().hasOnly(['movieId', 'progressSeconds', 'durationSeconds', 'seasonId', 'episodeId', 'updatedAt']) &&
          incoming().movieId == movieId &&
          incoming().progressSeconds is number && incoming().progressSeconds >= 0 &&
          incoming().durationSeconds is number && incoming().durationSeconds >= 0;
        allow delete: if isValidId(movieId) && (isOwner(uid) || isAdmin());
      }

      match /ratings/{movieId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isValidId(movieId) && isOwner(uid) && isNotBanned() &&
          incoming().keys().hasAll(['value']) &&
          incoming().keys().hasOnly(['value']) &&
          incoming().value is number && incoming().value >= 1 && incoming().value <= 5;
        allow delete: if isValidId(movieId) && (isOwner(uid) || isAdmin());
      }

      match /likes/{movieId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isValidId(movieId) && isOwner(uid) && isNotBanned() &&
          incoming().keys().hasAll(['movieId', 'addedAt']) &&
          incoming().keys().hasOnly(['movieId', 'addedAt']) &&
          incoming().movieId == movieId;
        allow delete: if isValidId(movieId) && (isOwner(uid) || isAdmin());
      }

      match /adUnlocks/{contentId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isValidId(contentId) && isOwner(uid) && isNotBanned() &&
          isValidAdUnlockDoc(incoming(), uid, contentId);
        allow delete: if isValidId(contentId) && (isOwner(uid) || isAdmin());
      }

      match /library/{titleId} {
        allow get: if isValidId(titleId) && (isOwner(uid) || isAdmin());
        allow list: if isOwner(uid) || isAdmin();
        allow create, update: if isValidId(titleId) && isOwner(uid) && isNotBanned() &&
          isValidLibraryDoc(incoming(), titleId);
        allow delete: if isValidId(titleId) && (isOwner(uid) || isAdmin());
      }

      match /progress/{titleId} {
        allow get: if isValidId(titleId) && (isOwner(uid) || isAdmin());
        allow list: if isOwner(uid) || isAdmin();
        allow create, update: if isValidId(titleId) && isOwner(uid) && isNotBanned() &&
          isValidProgressDoc(incoming(), titleId);
        allow delete: if isValidId(titleId) && (isOwner(uid) || isAdmin());
      }

      match /activity/{activityId} {
        allow get: if isValidId(activityId) && (isOwner(uid) || isAdmin());
        allow list: if isOwner(uid) || isAdmin();
        allow create: if isValidId(activityId) && isOwner(uid) && isNotBanned() &&
          isValidActivityDoc(incoming());
        allow update: if false;
        allow delete: if isValidId(activityId) && isAdmin();
      }

      match /achievements/{achievementId} {
        allow get: if isValidId(achievementId) && (isOwner(uid) || isAdmin());
        allow list: if isOwner(uid) || isAdmin();
        allow create: if isValidId(achievementId) && isOwner(uid) && isNotBanned() &&
          isValidAchievementDoc(incoming(), achievementId) &&
          getAfter(/databases/$(database)/documents/users/$(uid)/progress/$(incoming().titleId)).data.progressPercent == 100;
        allow update: if false;
        allow delete: if isValidId(achievementId) && isAdmin();
      }
    }

    // Movies & Series catalog
    match /movies/{movieId} {
      allow get: if isValidId(movieId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create: if isValidId(movieId) && isAdmin() && isValidMovieDoc(incoming());
      allow update: if isValidId(movieId) && isValidMovieDoc(incoming()) && (
        isAdmin() || (
          isSignedIn() && isNotBanned() &&
          existing().status == 'published' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['views', 'likesCount']) &&
          incoming().views >= existing().views &&
          incoming().views <= existing().views + 1 &&
          incoming().likesCount >= existing().likesCount - 1 &&
          incoming().likesCount <= existing().likesCount + 1
        )
      );
      allow delete: if isValidId(movieId) && isAdmin();
    }

    // Series seasons and episodes
    match /series/{seriesId}/seasons/{seasonId}/episodes/{episodeId} {
      allow read: if true;
      allow create, update: if isValidId(seriesId) && isValidId(seasonId) && isValidId(episodeId) &&
        isAdmin() && isValidEpisodeDoc(incoming());
      allow delete: if isValidId(seriesId) && isValidId(seasonId) && isValidId(episodeId) && isAdmin();
    }

    // Genres
    match /genres/{genreId} {
      allow read: if true;
      allow create, update: if isValidId(genreId) && isAdmin() && isValidGenreDoc(incoming());
      allow delete: if isValidId(genreId) && isAdmin();
    }

    // Banners
    match /banners/{bannerId} {
      allow get: if isValidId(bannerId) && (existing().isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create, update: if isValidId(bannerId) && isAdmin() && isValidBannerDoc(incoming());
      allow delete: if isValidId(bannerId) && isAdmin();
    }

    // Comments
    match /comments/{commentId} {
      allow get: if isValidId(commentId) && (existing().isHidden == false || isAdmin() || isOwner(existing().uid));
      allow list: if resource.data.isHidden == false || isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(commentId) && isSignedIn() && isNotBanned() &&
        isValidCommentDoc(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().isHidden == false &&
        exists(/databases/$(database)/documents/movies/$(incoming().movieId));
      allow update: if isValidId(commentId) && isValidCommentDoc(incoming()) && (
        isAdmin() || (
          isOwner(existing().uid) && isNotBanned() &&
          incoming().uid == existing().uid &&
          incoming().movieId == existing().movieId &&
          incoming().isHidden == existing().isHidden &&
          incoming().diff(existing()).affectedKeys().hasOnly(['text'])
        )
      );
      allow delete: if isValidId(commentId) && (isAdmin() || (isOwner(existing().uid) && isNotBanned()));
    }

    // Reports
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && (isAdmin() || isOwner(existing().uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(reportId) && isSignedIn() && isNotBanned() &&
        isValidReportDoc(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().status == 'open';
      allow update: if isValidId(reportId) && isAdmin() && isValidReportDoc(incoming());
      allow delete: if isValidId(reportId) && isAdmin();
    }

    // Site settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isAdmin() && isValidSiteSettingsDoc(incoming());
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // Admin activity logs
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidActivityLogDoc(incoming()) &&
        incoming().adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Monthly subscription plans
    match /plans/{planId} {
      allow get: if isValidId(planId) && (existing().isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create, update: if isValidId(planId) && isAdmin() && isValidPlanDoc(incoming());
      allow delete: if isValidId(planId) && isAdmin();
    }

    // Custom informational pages
    match /pages/{pageId} {
      allow get: if isValidId(pageId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isValidId(pageId) && isAdmin() && isValidCustomPageDoc(incoming());
      allow delete: if isValidId(pageId) && isAdmin();
    }

    // Contact form messages (public submit, admin-only read/manage)
    match /messages/{messageId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(messageId) && isValidContactMessageDoc(incoming()) && incoming().status == 'unread';
      allow update: if isValidId(messageId) && isAdmin() && isValidContactMessageDoc(incoming());
      allow delete: if isValidId(messageId) && isAdmin();
    }

    // Advertising: Custom Image Ads (public active read, admin CRUD, bounded metric increments)
    match /customAds/{adId} {
      allow get: if isValidId(adId) && (existing().status == 'active' || isAdmin());
      allow list: if resource.data.status == 'active' || isAdmin();
      allow create: if isValidId(adId) && isAdmin() && isValidCustomAdDoc(incoming());
      allow update: if isValidId(adId) && isValidCustomAdDoc(incoming()) && (
        isAdmin() || (
          existing().status == 'active' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['impressions', 'clicks', 'completions']) &&
          incoming().impressions >= existing().impressions &&
          incoming().impressions <= existing().impressions + 20 &&
          incoming().clicks >= existing().clicks &&
          incoming().clicks <= existing().clicks + 20 &&
          (!('completions' in incoming()) || incoming().completions >= (existing().get('completions', 0))) &&
          (!('completions' in incoming()) || incoming().completions <= (existing().get('completions', 0)) + 20)
        )
      );
      allow delete: if isValidId(adId) && isAdmin();
    }

    // Advertising: VAST Video & Overlay Ads (public active read, admin CRUD, bounded metric increments)
    match /vastAds/{adId} {
      allow get: if isValidId(adId) && (existing().status == 'active' || isAdmin());
      allow list: if resource.data.status == 'active' || isAdmin();
      allow create: if isValidId(adId) && isAdmin() && isValidVastAdDoc(incoming());
      allow update: if isValidId(adId) && isValidVastAdDoc(incoming()) && (
        isAdmin() || (
          existing().status == 'active' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['impressions', 'completions', 'skips', 'clicks', 'errors']) &&
          incoming().impressions >= existing().impressions &&
          incoming().impressions <= existing().impressions + 20 &&
          incoming().completions >= existing().completions &&
          incoming().completions <= existing().completions + 20 &&
          incoming().skips >= existing().skips &&
          incoming().skips <= existing().skips + 20 &&
          incoming().clicks >= existing().clicks &&
          incoming().clicks <= existing().clicks + 20 &&
          incoming().errors >= existing().errors &&
          incoming().errors <= existing().errors + 20
        )
      );
      allow delete: if isValidId(adId) && isAdmin();
    }

    // Advertising: Granular Events (public telemetry create, admin-only read/analytics)
    match /adEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(eventId) && isValidAdEventDoc(incoming());
      allow update, delete: if isAdmin();
    }

    // Advertising: Global Settings (public read, admin write)
    match /adSettings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isAdmin() && isValidAdSettingsDoc(incoming());
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // Orders & Revenue (student creates pending with exact active plan price; admin confirms/fails/refunds)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isValidOrderDoc(incoming()) && (
        isAdmin() || (
          isSignedIn() &&
          isNotBanned() &&
          incoming().userId == request.auth.uid &&
          incoming().paymentStatus == 'pending' &&
          (!('paidAt' in incoming()) || incoming().paidAt == null) &&
          exists(/databases/$(database)/documents/plans/$(incoming().planId)) &&
          get(/databases/$(database)/documents/plans/$(incoming().planId)).data.isActive == true &&
          incoming().amount == get(/databases/$(database)/documents/plans/$(incoming().planId)).data.pricePerMonth &&
          incoming().currency == get(/databases/$(database)/documents/plans/$(incoming().planId)).data.currency &&
          incoming().planName == get(/databases/$(database)/documents/plans/$(incoming().planId)).data.name &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          incoming().userEmail == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email &&
          incoming().userName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        )
      );
      allow update: if isValidId(orderId) &&
        isAdmin() &&
        isValidOrderDoc(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().planId == existing().planId &&
        incoming().amount == existing().amount &&
        incoming().currency == existing().currency &&
        incoming().createdAt == existing().createdAt &&
        (
          (existing().paymentStatus == 'pending' && incoming().paymentStatus in ['paid', 'failed']) ||
          (existing().paymentStatus == 'paid' && incoming().paymentStatus == 'refunded') ||
          (existing().paymentStatus == 'failed' && incoming().paymentStatus == 'pending')
        ) &&
        (incoming().paymentStatus != 'paid' || ('paidAt' in incoming() && incoming().paidAt is string && incoming().paidAt.size() >= 8));
      allow delete: if false;
    }

    // Blog CMS Posts (public read published, admin full CRUD)
    match /posts/{postId} {
      allow get: if isValidId(postId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create: if isValidId(postId) && isAdmin() && isValidPostDoc(incoming()) && incoming().authorUid == request.auth.uid;
      allow update: if isValidId(postId) && isAdmin() && isValidPostDoc(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(postId) && isAdmin();
    }

    // Admin collection-group reads for My Library subcollections
    match /{path=**}/library/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/progress/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/activity/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/achievements/{docId} {
      allow read: if isAdmin();
    }
  }
}
